{
  "name": "Puente Guizar",
  "short_name": "Puente",
  "description": "Recibe una imagen desde Compartir, ponle tu logo y precio, y mándala a WhatsApp, Facebook o Instagram.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1e0b36",
  "theme_color": "#3b1466",
  "lang": "es-MX",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "enlace",
      "files": [{ "name": "imagen", "accept": ["image/*"] }]
    }
  }
}
